{
  "name": "liftwise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first workout log and rule-based training insights.",
  "scripts": {
    "start": "vite --open /modern.html",
    "dev": "vite",
    "dev:modern": "vite --open /modern.html",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "preview:modern": "vite preview --open /modern.html",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/provision-lint-typescript.mjs",
    "lint": "node scripts/provision-lint-typescript.mjs && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "node --check src/app.js && node --check src/domain.js && node --check src/ui/import-chooser.js && npm run typecheck && npm run lint && npm run format:check && vitest run && vite build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.7",
    "zod": "4.4.3"
  }
}
