{
  "name": "liftwise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first workout log and rule-based training insights.",
  "scripts": {
    "start": "vite --open /modern.html",
    "dev": "vite",
    "dev:modern": "vite --open /modern.html",
    "build": "vite build",
    "preview": "vite preview",
    "preview:modern": "vite preview --open /modern.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "node --check src/app.js && node --check src/domain.js && node --check src/ui/import-chooser.js && npm run typecheck && vitest run && vite build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  }
}
